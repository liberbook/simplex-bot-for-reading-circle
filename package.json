{
  "name": "conatus",
  "version": "0.1.0",
  "description": "A small SimpleX Chat bot for a reading group: keeps every file the group shares, hands one back on a word, runs polls voted with reactions",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "bash scripts/e2e.sh",
    "doc": "node scripts/interface-doc.js"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liberbook/simplex-bot-for-reading-circle.git"
  },
  "homepage": "https://github.com/liberbook/simplex-bot-for-reading-circle#readme",
  "bugs": {
    "url": "https://github.com/liberbook/simplex-bot-for-reading-circle/issues"
  },
  "keywords": [
    "simplex",
    "simplex-chat",
    "bot",
    "chatbot",
    "reading-group",
    "book-club",
    "file-archive",
    "polls"
  ]
}
